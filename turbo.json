{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build:registry": {
      "dependsOn": [],
      "inputs": [
        "registry/**",
        "packages/ui/src/**",
        "packages/registry-builder/src/**"
      ],
      "outputs": ["apps/uikit/public/r/**", "apps/uikit/registry.json"]
    },
    "verify:registry": {
      "dependsOn": ["build:registry"],
      "inputs": [
        "registry/**",
        "packages/ui/src/**",
        "packages/registry-builder/src/**"
      ],
      "outputs": []
    }
  }
}

      "content": "import { Field } from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from \"@/components/ui/tooltip\"\nimport { IconPlaceholder } from \"@/components/ui/icon-placeholder\"\n\nexport default function Pattern() {\n  return (\n    <Field className=\"w-full max-w-xs\">\n      <Label htmlFor=\"label-tooltip\" className=\"gap-1\">\n        API Key\n        <TooltipProvider>\n          <Tooltip>\n            <TooltipTrigger className=\"inline-flex items-center\">\n              <span className=\"text-muted-foreground inline-flex cursor-help\">\n                <IconPlaceholder\n                  lucide=\"InfoIcon\"\n                  tabler=\"IconInfoCircle\"\n                  hugeicons=\"InformationCircleIcon\"\n                  phosphor=\"InfoIcon\"\n                  remixicon=\"RiInformationLine\"\n                  className=\"size-3.5\"\n                />\n              </span>\n            </TooltipTrigger>\n            <TooltipContent>\n              <p>Your API key can be found in the developer settings.</p>\n            </TooltipContent>\n          </Tooltip>\n        </TooltipProvider>\n      </Label>\n      <Input\n        id=\"label-tooltip\"\n        placeholder=\"sk_live_...\"\n        className=\"font-mono\"\n      />\n    </Field>\n  )\n}\n",
      "target": "components/examples/c-label-7.tsx"
    }

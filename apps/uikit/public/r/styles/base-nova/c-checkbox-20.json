      "type": "registry:block",
      "content": "import { Checkbox } from \"@/components/ui/checkbox\"\nimport { Field, FieldLabel } from \"@/components/ui/field\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipTrigger,\n} from \"@/components/ui/tooltip\"\nimport { IconPlaceholder } from \"@/components/ui/icon-placeholder\"\n\nexport default function Pattern() {\n  return (\n    <Field orientation=\"horizontal\" className=\"w-auto\">\n      <Checkbox id=\"tooltip-checkbox\" />\n\n      <div className=\"flex items-center gap-1.5\">\n        <FieldLabel htmlFor=\"tooltip-checkbox\">\n          Enable advanced analytics\n        </FieldLabel>\n        <Tooltip>\n          <TooltipTrigger className=\"text-muted-foreground\">\n            <IconPlaceholder\n              lucide=\"HelpCircleIcon\"\n              tabler=\"IconHelpCircle\"\n              hugeicons=\"HelpCircleIcon\"\n              phosphor=\"QuestionIcon\"\n              remixicon=\"RiQuestionLine\"\n              aria-hidden=\"true\"\n              className=\"size-3.5\"\n            />\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            Advanced analytics provides deeper insights into user behavior and\n            system performance.\n          </TooltipContent>\n        </Tooltip>\n      </div>\n    </Field>\n  )\n}\n",
      "target": "components/examples/c-checkbox-20.tsx"
    }

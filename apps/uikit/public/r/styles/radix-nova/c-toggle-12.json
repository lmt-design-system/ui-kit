      "content": "import { Toggle } from \"@/components/ui/toggle\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from \"@/components/ui/tooltip\"\nimport { IconPlaceholder } from \"@/components/ui/icon-placeholder\"\n\nexport default function Pattern() {\n  return (\n    <div className=\"flex items-center justify-center\">\n      <TooltipProvider>\n        <Tooltip>\n          <TooltipTrigger asChild>\n            <Toggle variant=\"outline\" aria-label=\"Pin to sidebar\">\n              <IconPlaceholder\n                lucide=\"PinIcon\"\n                tabler=\"IconPin\"\n                hugeicons=\"Pin02Icon\"\n                phosphor=\"PushPinIcon\"\n                remixicon=\"RiPushpinLine\"\n              />\n            </Toggle>\n          </TooltipTrigger>\n          <TooltipContent>\n            <p className=\"text-sm\">Pin to sidebar</p>\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </div>\n  )\n}\n",
      "target": "components/examples/c-toggle-12.tsx"
    }
  ],

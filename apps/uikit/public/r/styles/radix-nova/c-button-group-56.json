      "content": "import { Button } from \"@/components/ui/button\"\nimport { ButtonGroup } from \"@/components/ui/button-group\"\nimport { IconPlaceholder } from \"@/components/ui/icon-placeholder\"\n\nconst attachment = {\n  name: \"Q4-Product-Roadmap.pdf\",\n  size: \"2.4 MB\",\n}\n\nexport default function Pattern() {\n  return (\n    <ButtonGroup>\n      <Button variant=\"outline\" size=\"xs\">\n        <IconPlaceholder\n          lucide=\"PaperclipIcon\"\n          tabler=\"IconPaperclip\"\n          hugeicons=\"Attachment02Icon\"\n          phosphor=\"PaperclipIcon\"\n          remixicon=\"RiAttachment2\"\n          aria-hidden=\"true\"\n        />\n        {attachment.name}\n        <span className=\"opacity-60\">({attachment.size})</span>\n      </Button>\n      <Button variant=\"outline\" size=\"icon-xs\" aria-label=\"Download attachment\">\n        <IconPlaceholder\n          lucide=\"DownloadIcon\"\n          tabler=\"IconDownload\"\n          hugeicons=\"Download01Icon\"\n          phosphor=\"DownloadSimpleIcon\"\n          remixicon=\"RiDownload2Line\"\n          aria-hidden=\"true\"\n        />\n      </Button>\n    </ButtonGroup>\n  )\n}\n",
      "target": "components/examples/c-button-group-56.tsx"
    }

    {
      "path": "registry/bases/radix/components/field/c-field-6.tsx",
      "type": "registry:block",
      "content": "import {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@/components/ui/input-otp\"\nimport {\n  NativeSelect,\n  NativeSelectOption,\n} from \"@/components/ui/native-select\"\n\nexport default function Pattern() {\n  return (\n    <div className=\"mx-auto w-full max-w-xs\">\n      <FieldGroup>\n        <Field>\n          <FieldLabel htmlFor=\"verification-method\">\n            Verification Method\n          </FieldLabel>\n          <NativeSelect id=\"verification-method\" defaultValue=\"email\">\n            <NativeSelectOption value=\"email\">Email Address</NativeSelectOption>\n            <NativeSelectOption value=\"sms\">\n              SMS Text Message\n            </NativeSelectOption>\n            <NativeSelectOption value=\"app\">\n              Authenticator App\n            </NativeSelectOption>\n          </NativeSelect>\n          <FieldDescription>\n            Choose how you want to receive your security code.\n          </FieldDescription>\n        </Field>\n        <Field>\n          <FieldLabel htmlFor=\"otp-code\">Security Code</FieldLabel>\n          <InputOTP id=\"otp-code\" maxLength={6}>\n            <InputOTPGroup>\n              <InputOTPSlot index={0} />\n              <InputOTPSlot index={1} />\n              <InputOTPSlot index={2} />\n            </InputOTPGroup>\n            <InputOTPSeparator />\n            <InputOTPGroup>\n              <InputOTPSlot index={3} />\n              <InputOTPSlot index={4} />\n              <InputOTPSlot index={5} />\n            </InputOTPGroup>\n          </InputOTP>\n          <FieldDescription>\n            Enter the 6-digit code to verify your identity.\n          </FieldDescription>\n        </Field>\n      </FieldGroup>\n    </div>\n  )\n}\n",
      "target": "components/examples/c-field-6.tsx"
    }
  ],
  "meta": {
    "order": 6
  }
}
      "content": "import { IconStack } from \"@/components/reui/icon-stack\"\n\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Empty,\n  EmptyContent,\n  EmptyDescription,\n  EmptyHeader,\n  EmptyMedia,\n  EmptyTitle,\n} from \"@/components/ui/empty\"\nimport { IconPlaceholder } from \"@/components/ui/icon-placeholder\"\n\nexport default function Pattern() {\n  return (\n    <div className=\"flex items-center justify-center p-4\">\n      <Empty className=\"max-w-md py-10\">\n        <EmptyHeader>\n          <EmptyMedia>\n            <IconStack aria-hidden=\"true\" className=\"text-primary h-24 w-22\">\n              <IconPlaceholder\n                lucide=\"InboxIcon\"\n                tabler=\"IconInbox\"\n                hugeicons=\"InboxIcon\"\n                phosphor=\"TrayIcon\"\n                remixicon=\"RiInboxLine\"\n                className=\"text-primary size-5\"\n              />\n            </IconStack>\n          </EmptyMedia>\n          <EmptyTitle>Workspace is ready</EmptyTitle>\n          <EmptyDescription>\n            Invite teammates or connect a data source to start filling this\n            view.\n          </EmptyDescription>\n        </EmptyHeader>\n\n        <EmptyContent className=\"flex-row justify-center gap-2\">\n          <Button size=\"sm\">\n            <IconPlaceholder\n              lucide=\"UserPlusIcon\"\n              tabler=\"IconUserPlus\"\n              hugeicons=\"UserAdd01Icon\"\n              phosphor=\"UserPlusIcon\"\n              remixicon=\"RiUserAddLine\"\n              data-icon=\"inline-start\"\n            />\n            Invite team\n          </Button>\n          <Button variant=\"outline\" size=\"sm\">\n            <IconPlaceholder\n              lucide=\"DatabaseIcon\"\n              tabler=\"IconDatabase\"\n              hugeicons=\"DatabaseIcon\"\n              phosphor=\"DatabaseIcon\"\n              remixicon=\"RiDatabase2Line\"\n              data-icon=\"inline-start\"\n            />\n            Connect source\n          </Button>\n        </EmptyContent>\n      </Empty>\n    </div>\n  )\n}\n",
      "target": "components/examples/c-icon-stack-5.tsx"
    }

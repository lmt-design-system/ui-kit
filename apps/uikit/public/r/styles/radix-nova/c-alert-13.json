  "registryDependencies": [
    "https://uikit.limmengty.com/r/styles/radix-nova/alert-block.json",
    "https://uikit.limmengty.com/r/styles/radix-nova/button.json",
    "https://uikit.limmengty.com/r/styles/radix-nova/frame.json",
    "https://uikit.limmengty.com/r/styles/radix-nova/icon-placeholder.json",
